# Secrets
.env
.env.*
!.env.example
*.key
*.pem

# Runtime data
logs/*.log
*.pid
*.sqlite
*.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Backups
*.bak
*.backup

# Runtime state (not code)
logs/.pending_confirmation.json
logs/.restart_cooldowns.json

# Backup archives (large, contain live service data — never commit)
jarvis-backups/

# Runtime logs directory (contains audit.db and cooldown state files)
logs/*.json

# Restore safety copies and test sandboxes (never commit)
jarvis-restore-safety-backups/
jarvis-restore-test/

# Integrity check state — machine-specific, changes on every --accept
.integrity-baseline.json

# Morning digest output — generated daily, not source
morning-digest/
